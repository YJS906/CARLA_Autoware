# syntax=docker/dockerfile:1.7
# Incremental build from the preserved CARLA runtime; no live library mounts.
ARG CARLA_BASE_IMAGE=selfcar-2026-carla:behavior-repair-20260922
FROM ${CARLA_BASE_IMAGE}
USER root
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
COPY vtd_overlay/src /opt/selfcar-build/src
RUN find /opt/selfcar_overlay/share -name package.sh -exec \
      sed -i 's|^_colcon_package_sh_COLCON_CURRENT_PREFIX="[^"]*"|_colcon_package_sh_COLCON_CURRENT_PREFIX="/opt/selfcar_overlay"|' {} + && \
    source /opt/ros/jazzy/setup.bash && \
    source /opt/autoware/setup.bash && \
    source /opt/selfcar_overlay/setup.bash && \
    source /opt/carla_overlay/setup.bash && \
    export CMAKE_BUILD_PARALLEL_LEVEL=2 MAKEFLAGS=-j2 && \
    colcon --log-base /opt/selfcar-build/lane-start-log build \
      --base-paths /opt/selfcar-build/src \
      --packages-select autoware_behavior_path_lane_change_module \
        autoware_behavior_path_avoidance_by_lane_change_module \
      --executor sequential --merge-install \
      --build-base /opt/selfcar-build/intersection-exit-build \
      --install-base /opt/selfcar_overlay \
      --cmake-args -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF && \
    find /opt/selfcar-build/src -type f -not -path '*/__pycache__/*' -print0 | \
      sort -z | xargs -0 sha256sum > /opt/selfcar-build/lane-start-source.sha256

COPY config/carla/control/trajectory_follower/longitudinal/pid.param.yaml /opt/carla-config/control/trajectory_follower/longitudinal/pid.param.yaml
COPY config/carla/control/trajectory_follower/longitudinal/pid.param.yaml /opt/autoware/autoware_launch/share/autoware_launch/config/control/trajectory_follower/longitudinal/pid.param.yaml
